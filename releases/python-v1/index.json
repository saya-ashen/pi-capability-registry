{
  "schemaVersion": 1,
  "packages": [
    {
      "manifest": {
        "schemaVersion": 1,
        "id": "python-kit",
        "version": "0.1.0",
        "description": "Python 编写指南和任务独立的 Python 执行环境",
        "host": {
          "os": [
            "linux"
          ],
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "preparation": {
          "granularity": "capability"
        },
        "permissions": {
          "filesystem": "package-state-and-workspace",
          "network": false
        },
        "provides": [
          {
            "id": "python.author",
            "interfaceVersion": 1,
            "kind": "guidance",
            "description": "Python 编写与测试方法",
            "instructions": "AUTHOR.md",
            "tools": []
          },
          {
            "id": "python.execute",
            "interfaceVersion": 1,
            "kind": "tools",
            "description": "在任务独立的 Python 虚拟环境执行代码",
            "instructions": "EXECUTE.md",
            "tools": [
              {
                "name": "python_run",
                "description": "Run Python code in the prepared task venv. No third-party dependencies are installed.",
                "exposure": "on_activation",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          }
        ],
        "requires": [
          {
            "id": "shell.execute",
            "interfaceVersion": 1,
            "phase": "prepare",
            "for": [
              "python.execute"
            ]
          }
        ],
        "lifecycle": {
          "runtime": "node",
          "entry": "worker.mjs"
        }
      },
      "sha256": "a5972a90cfb3762e32b7cb93bda99161a48136544afc42217d6adfb4f6260d2e",
